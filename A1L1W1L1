<script>
(function () {
  "use strict";

  /* ------------------------------------------------------------------
     ONE CENTRAL AUDIO LIBRARY
     Every official recording supplied for this activity is embedded
     here as the complete Base64 of the real file, so the activity is
     self-contained: no relative paths, no audio folder, nothing to
     break when the file is moved or uploaded to Moodle. No recording
     is ever replaced by speech synthesis.
     ------------------------------------------------------------------ */
  var AUDIO_FILES = {
    /* Hello.  (from Hello_mp3.mp3, 34202 bytes) */
    hello: "data:audio/mpeg;base64,",

    /* My name is Amina.  (from mynameisamina_mp3.mp3, 45487 bytes) */
    myNameIsAmina: "data:audio/mpeg;base64,",

    /* What's your name?  (from whatsyourname_mp3.mp3, 40889 bytes) */
    whatsYourName: "data:audio/mpeg;base64,",

    /* I'm Samira.  (from Imsamira_mp3.mp3, 39635 bytes) */
    imSamira: "data:audio/mpeg;base64,",

    /* I'm from Egypt.  (from imfromegypt_mp3.mp3, 38799 bytes) */
    imFromEgypt: "data:audio/mpeg;base64,",

    /* Where are you from?  (from whereareyoufrom_mp3.mp3, 45487 bytes) */
    whereAreYouFrom: "data:audio/mpeg;base64,",

    /* Nice to meet you.  (from nicetomeetyou_mp3.mp3, 42561 bytes) */
    niceToMeetYou: "data:audio/mpeg;base64,",

    /* Nice to meet you, too.  (from nicetomeetyoutoo_mp3.mp3, 47159 bytes) */
    niceToMeetYouToo: "data:audio/mpeg;base64,"
  };

  /* Confirm each entry is a real, complete MP3 Data URL. */
  Object.keys(AUDIO_FILES).forEach(function (key) {
    var src = AUDIO_FILES[key];
    if (typeof src !== "string" ||
        src.indexOf("data:audio/mpeg;base64,") !== 0 ||
        src.length < 2000) {
      console.error("Invalid or incomplete embedded recording:", key);
    }
  });

  /* ---------- Completion (one time only) ---------- */
  let completionSent = false;

  function activityCompleted() {
      if (completionSent) return;
      completionSent = true;
      console.log("W1L1 Pronunciation Clinic completed");
  }

  /* ---------- Elements ---------- */
  var screens   = Array.prototype.slice.call(document.querySelectorAll(".screen"));
  var backBtn   = document.getElementById("backBtn");
  var nextBtn   = document.getElementById("nextBtn");
  var doneBtn   = document.getElementById("doneBtn");
  var counter   = document.getElementById("counter");
  var fill      = document.getElementById("progressFill");
  var reduce    = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var index     = 0;

  /* ---------- Screen navigation ---------- */
  function render(moveFocus) {
    screens.forEach(function (s, i) { s.hidden = (i !== index); });

    var last = (index === screens.length - 1);
    counter.textContent = "Screen " + (index + 1) + " of " + screens.length;
    fill.style.width = (((index + 1) / screens.length) * 100) + "%";

    backBtn.disabled = (index === 0);
    nextBtn.hidden = last;
    doneBtn.hidden = !last;
    doneBtn.disabled = !last;

    stopAudio();

    if (moveFocus) {
      var title = screens[index].querySelector(".screen-title");
      if (title) { title.focus(); }
    }
    window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
  }

  function go(delta) {
    var target = index + delta;
    if (target < 0 || target > screens.length - 1) { return; }
    index = target;
    render(true);
  }

  nextBtn.addEventListener("click", function () { go(1); });
  backBtn.addEventListener("click", function () { go(-1); });
  Array.prototype.forEach.call(document.querySelectorAll("[data-next]"), function (b) {
    b.addEventListener("click", function () { go(1); });
  });

  doneBtn.addEventListener("click", function () {
    if (doneBtn.disabled) { return; }
    activityCompleted();
    doneBtn.disabled = true;
    doneBtn.textContent = "Completed";
    var ready = document.querySelector("#s15 .ready");
    if (ready) { ready.textContent = "Saved. You are ready for Build Useful English."; }
  });

  /* ---------- ONE AUDIO ENGINE — one sound at a time ---------- */
  var currentAudio = null;
  var currentHost = null;

  function setStatus(node, text) {
    if (!node) { return; }
    var s = node.querySelector(".status");
    if (s) { s.textContent = text; }
  }

  function stopAudio() {
    if (currentAudio) {
      try {
        currentAudio.pause();
        currentAudio.currentTime = 0;
      } catch (e) {}
      currentAudio = null;
    }
    if (currentHost) { setStatus(currentHost, ""); currentHost = null; }
    if (window.speechSynthesis) {
      try { window.speechSynthesis.cancel(); } catch (e) {}
    }
  }

  function playAudio(src, host, playingText, endedText) {
    if (!src) { console.error("Missing audio source."); return; }
    stopAudio();
    var audio = new Audio();
    audio.preload = "auto";
    audio.src = src;
    currentAudio = audio;
    currentHost = host || null;
    setStatus(host, playingText || "");
    audio.addEventListener("ended", function () {
      if (currentAudio === audio) {
        currentAudio = null;
        currentHost = null;
        setStatus(host, endedText || "");
      }
    });
    audio.addEventListener("error", function () {
      console.error("Audio loading error:", audio.error ? audio.error.code : "unknown");
    });
    var promise = audio.play();
    if (promise && typeof promise.catch === "function") {
      promise.catch(function (error) {
        console.error("Audio playback failed:", error);
      });
    }
  }

  /* Every sound button plays from the central library, on a real click
     or tap, and can be replayed without limit. */
  Array.prototype.forEach.call(document.querySelectorAll("[data-sound]"), function (btn) {
    var key = btn.getAttribute("data-sound");
    if (!AUDIO_FILES[key]) {
      console.error("No recording mapped for button:", key);
      return;
    }
    btn.addEventListener("click", function () {
      playAudio(
        AUDIO_FILES[key],
        btn.closest(".player"),
        "Playing the model.",
        "Finished. You can play it again."
      );
    });
  });

  /* ---------- Screen 12: optional recording ---------- */
  var recPanel    = document.getElementById("recPanel");
  var recFallback = document.getElementById("recFallback");
  var recStart    = document.getElementById("recStart");
  var recStop     = document.getElementById("recStop");
  var recPlay     = document.getElementById("recPlay");
  var recStatus   = document.getElementById("recStatus");

  var canRecord = !!(navigator.mediaDevices &&
                     navigator.mediaDevices.getUserMedia &&
                     window.MediaRecorder);

  if (canRecord) { recPanel.hidden = false; } else { recFallback.hidden = false; }

  var recorder = null;
  var chunks = [];
  var recordedSrc = null;

  function showFallback(message) {
    recPanel.hidden = true;
    recFallback.hidden = false;
    var p = recFallback.querySelector(".lead");
    if (p && message) { p.textContent = message; }
  }

  if (canRecord) {
    recStart.addEventListener("click", function () {
      stopAudio();
      navigator.mediaDevices.getUserMedia({ audio: true }).then(function (stream) {
        try {
          recorder = new MediaRecorder(stream);
        } catch (e) {
          showFallback("Recording could not start in this browser, so practise out loud instead.");
          return;
        }
        chunks = [];
        recorder.addEventListener("dataavailable", function (e) {
          if (e.data && e.data.size > 0) { chunks.push(e.data); }
        });
        recorder.addEventListener("stop", function () {
          stream.getTracks().forEach(function (t) { t.stop(); });
          var blob = new Blob(chunks, { type: recorder.mimeType || "audio/webm" });
          var reader = new FileReader();
          reader.addEventListener("load", function () {
            recordedSrc = reader.result;   /* a Data URL, like the official recordings */
            recPlay.disabled = false;
            recStatus.textContent = "Recording saved on this page. Play it and listen to yourself.";
          });
          reader.addEventListener("error", function () {
            console.error("Could not read the learner recording.");
            recStatus.textContent = "That recording could not be saved. You can record again.";
          });
          reader.readAsDataURL(blob);
        });
        recorder.start();
        recStart.disabled = true;
        recStop.disabled = false;
        recStatus.textContent = "Recording. Say: My name is Amina.";
      }).catch(function () {
        recStatus.textContent = "The microphone is not available. Use the out-loud practice below instead.";
        showFallback("The microphone is not available, so practise out loud instead.");
      });
    });

    recStop.addEventListener("click", function () {
      if (recorder && recorder.state !== "inactive") { recorder.stop(); }
      recStart.disabled = false;
      recStop.disabled = true;
      recStatus.textContent = "Stopped. Preparing your recording.";
    });

    recPlay.addEventListener("click", function () {
      if (!recordedSrc) { return; }
      playAudio(recordedSrc);
      recStatus.textContent = "Playing your recording.";
    });
  }

  var selfFeedback = document.getElementById("selfCheckFeedback");
  Array.prototype.forEach.call(document.querySelectorAll("[data-selfcheck]"), function (btn) {
    btn.addEventListener("click", function () {
      var value = btn.getAttribute("data-selfcheck");
      selfFeedback.hidden = false;
      if (value === "yes") {
        selfFeedback.textContent = "Good. Clear speech is the goal, not a perfect accent.";
      } else if (value === "almost") {
        selfFeedback.textContent = "That is normal. Play the model once more and say it a little more slowly.";
      } else {
        selfFeedback.textContent = "Take your time. You can record again as often as you want.";
      }
    });
  });

  /* ---------- Start ---------- */
  render(false);
})();
</script>
</body>
</html>
