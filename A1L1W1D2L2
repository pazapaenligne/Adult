    "speakArabic": "data:audio/mpeg;base64,",
    /* Ispeakfrenchand_mp3.mp3 */
    "speakFrench": "data:audio/mpeg;base64,",
    /* Ilearningenglish_mp3.mp3 */
    "learningEnglish": "data:audio/mpeg;base64,",
    /* Im35yearsoldIspeak_mp3.mp3 */
    "profile35": "data:audio/mpeg;base64,",
    /* conversation_mp3.mp3 */
    "conversation": "data:audio/mpeg;base64,"
  };

  /* ==========================================================
     ONE AUDIO ENGINE — one sound at a time, learner-triggered
     ========================================================== */
  var currentAudio = null;

  function stopAudio(){
    if(currentAudio){
      try{ currentAudio.pause(); currentAudio.currentTime = 0; }catch(e){}
      currentAudio = null;
    }
    if(window.speechSynthesis){
      try{ window.speechSynthesis.cancel(); }catch(e){}
    }
    var playing = document.querySelectorAll(".btn.playing");
    Array.prototype.forEach.call(playing, function(b){
      b.classList.remove("playing");
      b.textContent = b.dataset.idle || "Play";
    });
  }

  function playAudio(src, btn){
    if(!src){ console.error("Missing audio source."); return; }
    stopAudio();

    var audio = new Audio();
    audio.preload = "auto";
    audio.src = src;
    currentAudio = audio;

    if(btn){
      btn.dataset.idle = btn.dataset.idle || btn.textContent;
      btn.classList.add("playing");
      btn.textContent = "Playing…";
    }

    function settle(){
      if(btn){
        btn.classList.remove("playing");
        btn.textContent = "Listen again";
        btn.dataset.idle = "Listen again";
      }
    }

    audio.addEventListener("ended", function(){
      if(currentAudio === audio){ currentAudio = null; }
      settle();
    });

    audio.addEventListener("error", function(){
      console.error("Audio loading error:", audio.error ? audio.error.code : "unknown");
      settle();
    });

    var promise = audio.play();
    if(promise && typeof promise.catch === "function"){
      promise.catch(function(error){
        console.error("Audio playback failed:", error);
        settle();
      });
    }
  }

  /* build the listening controls for every item */
  Array.prototype.forEach.call(document.querySelectorAll(".item"), function(item){
    var key = item.dataset.audio;
    var text = item.dataset.text;

    var row = document.createElement("div");
    row.className = "audio-row";

    var playBtn = document.createElement("button");
    playBtn.type = "button";
    playBtn.className = "btn";
    playBtn.textContent = "Listen";
    playBtn.dataset.idle = "Listen";
    playBtn.setAttribute("aria-label", "Listen to the recording");

    var wordsBtn = document.createElement("button");
    wordsBtn.type = "button";
    wordsBtn.className = "btn secondary";
    wordsBtn.textContent = "Show the words";

    var transcript = document.createElement("p");
    transcript.className = "transcript";
    transcript.hidden = true;
    transcript.textContent = text;

    playBtn.addEventListener("click", function(){
      playAudio(AUDIO_FILES[key], playBtn);
    });

    wordsBtn.addEventListener("click", function(){
      transcript.hidden = !transcript.hidden;
      wordsBtn.textContent = transcript.hidden ? "Show the words" : "Hide the words";
    });

    row.appendChild(playBtn);
    row.appendChild(wordsBtn);

    var legend = item.querySelector("legend");
    if(legend && legend.nextSibling){
      item.insertBefore(row, legend.nextSibling);
      item.insertBefore(transcript, row.nextSibling);
    }else{
      item.appendChild(row);
      item.appendChild(transcript);
    }
  });

  /* ==========================================================
     CHOICE ITEMS — unlimited retry, text as well as colour
     ========================================================== */
  Array.prototype.forEach.call(document.querySelectorAll(".item"), function(item){
    var answer = item.dataset.answer;
    if(!answer) return;
    var fb = item.querySelector(".feedback");
    var opts = item.querySelectorAll(".opt");
    var solved = false;

    Array.prototype.forEach.call(opts, function(opt){
      opt.addEventListener("click", function(){
        if(solved) return;
        Array.prototype.forEach.call(opts, function(o){ o.classList.remove("wrong"); });
        if(opt.dataset.key === answer){
          solved = true;
          opt.classList.add("correct");
          fb.className = "feedback good";
          fb.textContent = "✔ Good choice. That's useful English." +
            (item.dataset.explain ? " " + item.dataset.explain : "");
        }else{
          opt.classList.add("wrong");
          fb.className = "feedback bad";
          fb.textContent = "✗ Listen again and try once more. Please try again.";
        }
      });
    });
  });

  /* ==========================================================
     DIALOGUE ORDERING — tap to order, no drag and drop
     ========================================================== */
  var DIALOGUE = [
    "How old are you?",
    "I am 25 years old.",
    "What languages do you speak?",
    "I speak French and a little English."
  ];
  var SHUFFLED = [
    "I am 25 years old.",
    "What languages do you speak?",
    "I speak French and a little English.",
    "How old are you?"
  ];

  var orderLine = document.getElementById("order-line");
  var lineBank = document.getElementById("line-bank");
  var orderFb = document.getElementById("order-fb");
  var placed = [];

  function renderOrder(){
    orderLine.textContent = "";
    orderLine.classList.remove("correct", "wrong");
    if(placed.length === 0){
      var ph = document.createElement("span");
      ph.className = "placeholder";
      ph.textContent = "Choose the lines here, in order.";
      orderLine.appendChild(ph);
      return;
    }
    placed.forEach(function(entry, i){
      var chip = document.createElement("button");
      chip.type = "button";
      chip.className = "chip";
      chip.textContent = (i + 1) + ". " + entry.text;
      chip.setAttribute("aria-label", "Remove line: " + entry.text);
      chip.addEventListener("click", function(){
        entry.source.disabled = false;
        placed.splice(i, 1);
        renderOrder();
        orderFb.className = "feedback";
        orderFb.textContent = "";
      });
      orderLine.appendChild(chip);
    });
  }

  SHUFFLED.forEach(function(text){
    var b = document.createElement("button");
    b.type = "button";
    b.className = "chip";
    b.textContent = text;
    b.addEventListener("click", function(){
      if(b.disabled) return;
      b.disabled = true;
      placed.push({ text: text, source: b });
      renderOrder();
      orderFb.className = "feedback";
      orderFb.textContent = "";
    });
    lineBank.appendChild(b);
  });

  document.getElementById("order-check").addEventListener("click", function(){
    if(placed.length === 0){
      orderFb.className = "feedback info";
      orderFb.textContent = "Choose the lines first.";
      return;
    }
    var ok = placed.length === DIALOGUE.length && placed.every(function(p, i){ return p.text === DIALOGUE[i]; });
    if(ok){
      orderLine.classList.add("correct");
      orderFb.className = "feedback good";
      orderFb.textContent = "✔ Good choice. That's useful English. You're building confidence.";
    }else{
      orderLine.classList.add("wrong");
      orderFb.className = "feedback bad";
      orderFb.textContent = "✗ Listen again and try once more. The conversation starts with a question about age. Please try again.";
    }
  });

  document.getElementById("order-clear").addEventListener("click", function(){
    placed = [];
    Array.prototype.forEach.call(lineBank.querySelectorAll(".chip"), function(c){ c.disabled = false; });
    renderOrder();
    orderFb.className = "feedback";
    orderFb.textContent = "";
  });

  renderOrder();

  /* ==========================================================
     SCREENS — one at a time; the learner may go back and repeat
     ========================================================== */
  var screens = Array.prototype.slice.call(document.querySelectorAll(".screen"));
  var total = screens.length;
  var index = 0;
  var doneBtn = document.getElementById("done-btn");
  doneBtn.disabled = true;

  function showScreen(i){
    index = Math.max(0, Math.min(total - 1, i));
    stopAudio();
    screens.forEach(function(s, n){ s.hidden = (n !== index); });
    document.getElementById("progress-text").textContent = "Screen " + (index + 1) + " of " + total;
    document.getElementById("progress-fill").style.width = (((index + 1) / total) * 100) + "%";
    doneBtn.disabled = (index !== total - 1) || completionSent;
    window.scrollTo(0, 0);
    var h = screens[index].querySelector("h1, h2");
    if(h){ h.setAttribute("tabindex", "-1"); h.focus(); }
  }

  Array.prototype.forEach.call(document.querySelectorAll(".next"), function(b){
    b.addEventListener("click", function(){ showScreen(index + 1); });
  });

  Array.prototype.forEach.call(document.querySelectorAll(".back"), function(b){
    b.addEventListener("click", function(){ showScreen(index - 1); });
  });

  /* ==========================================================
     COMPLETION — once only, no automatic navigation
     ========================================================== */
  var completionSent = false;

  function activityCompleted(){
    if(completionSent) return;
    completionSent = true;
    console.log("Adult ESL W1L2 Step 2 completed");
  }

  doneBtn.addEventListener("click", function(){
    if(doneBtn.disabled) return;
    activityCompleted();
    var fb = document.getElementById("done-fb");
    fb.className = "feedback good";
    fb.textContent = "Well done. You can close this page and open the Pronunciation Clinic when you are ready.";
    doneBtn.disabled = true;
  });

  showScreen(0);
})();
</script>

</body>
</html>
