<style>

/* ------------------------------------------------------------------
   Pazapa Brand Guidelines, 2017–2018 edition
   Colours: the six brand colours and their published 20/40/60/80%
   tints only — no darkened shades.
   Typography: Filson Soft Black headings (never all capitals),
   Open Sans body. No font files are embedded and no external
   stylesheet is loaded; the stacks fall back where a face is absent.
   ------------------------------------------------------------------ */
:root{
  --blue:#36BBD6;
  --green:#C9D646;
  --yellow:#FCC104;
  --red:#E6352B;
  --grey:#EBEBEB;
  --ink:#2E2E2D;

  --blue-60:#86D6E6;
  --blue-40:#AFE4EF;
  --blue-20:#D7F1F7;
  --green-40:#E9EFB5;
  --green-20:#F4F7DA;
  --yellow-40:#FDE69B;
  --yellow-20:#FEF3CD;
  --red-20:#FAD7D5;
  --ink-60:#818281;

  --white:#FFFFFF;
  --radius:14px;
  --shadow:0 2px 6px rgba(46,46,45,.12);
  --font-head:'Filson Soft','Open Sans',Arial,sans-serif;
  --font-body:'Open Sans',Arial,sans-serif;
}

*{box-sizing:border-box;}
html,body{margin:0;padding:0;}

body{
  font-family:var(--font-body);
  font-size:18px;line-height:1.55;
  color:var(--ink);background:var(--grey);
  padding:0 0 48px;
}

h1,h2,h3{font-family:var(--font-head);font-weight:800;letter-spacing:.2px;color:var(--ink);}
h1{font-size:1.9rem;line-height:1.25;margin:0 0 12px;}
h2{font-size:1.5rem;line-height:1.3;margin:0 0 10px;}
h3{font-size:1.1rem;margin:22px 0 8px;}

.screen > h1::before,
.screen > h2::before{
  content:"";display:inline-block;width:15px;height:15px;
  background:var(--green);margin-right:10px;vertical-align:baseline;
}

p{margin:0 0 14px;}

/* header */
.site-header{background:var(--white);border-bottom:6px solid var(--blue);padding:14px 20px;}
.site-header .inner{max-width:880px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;gap:10px 16px;}
/* official logo, colour version without tagline, on a white background;
   clear space is reserved with the margin below — the artwork is unmodified */
.site-header .logo{height:37px;width:auto;display:block;margin-right:18px;}
.brand{font-family:var(--font-head);font-weight:800;font-size:1.05rem;color:var(--ink);}
.lesson-ref{font-size:.9rem;color:var(--ink-60);margin-left:auto;}
@media(max-width:520px){.site-header .logo{height:30px;margin-right:12px;}}

main{max-width:880px;margin:24px auto;padding:0 16px;}
.card{background:var(--white);border-radius:var(--radius);box-shadow:var(--shadow);padding:26px 22px;}
.screen[hidden]{display:none;}
.intro{font-size:1.05rem;}

.progress{display:flex;align-items:center;gap:10px;margin:0 0 16px;font-size:.9rem;}
.progress .bar{flex:1;height:8px;background:var(--white);border:1px solid var(--blue-40);border-radius:999px;overflow:hidden;}
.progress .bar span{display:block;height:100%;background:var(--blue);width:14%;transition:width .3s ease;}

/* words and lists */
.words{list-style:none;margin:0 0 18px;padding:0;display:flex;flex-wrap:wrap;gap:10px;}
.words li{background:var(--blue-20);border-left:6px solid var(--blue);border-radius:8px;padding:10px 16px;font-weight:600;}

.figure{margin:0 0 18px;}
.figure svg{width:100%;max-width:420px;height:auto;display:block;border-radius:12px;}

.note{background:var(--yellow-20);border-left:6px solid var(--yellow);border-radius:8px;padding:12px 16px;font-size:.98rem;}

/* buttons */
button{font-family:var(--font-body);font-size:1rem;}
.btn{
  display:inline-flex;align-items:center;justify-content:center;
  min-height:48px;min-width:48px;padding:12px 26px;
  border:2px solid var(--blue);border-radius:999px;
  background:var(--blue);color:var(--ink);font-weight:700;font-size:1.05rem;cursor:pointer;
}
.btn:hover{background:var(--blue-60);border-color:var(--blue-60);}
.btn.secondary{background:var(--white);color:var(--ink);border:2px solid var(--blue);}
.btn.secondary:hover{background:var(--blue-20);}
.btn.done{background:var(--green);border-color:var(--green);}
.btn.done:hover{background:var(--green-40);border-color:var(--green-40);}
.btn:disabled{background:var(--grey);color:var(--ink-60);border-color:var(--grey);cursor:not-allowed;}
.btn.playing{background:var(--yellow);border-color:var(--yellow);}

.nav{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px;padding-top:18px;border-top:2px solid var(--grey);}
.nav .spacer{flex:1;}

:focus-visible{outline:4px solid var(--yellow);outline-offset:3px;}

/* tasks */
fieldset.task{border:none;margin:0 0 26px;padding:0;}
fieldset.task legend{font-size:1.1rem;font-weight:600;font-family:var(--font-body);padding:0;margin:0 0 10px;}
.audio-row{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 12px;}
.transcript{background:var(--grey);border-radius:8px;padding:10px 14px;margin:0 0 12px;font-weight:600;}
.transcript[hidden]{display:none;}

.options{display:grid;gap:10px;margin:0 0 4px;}
@media(min-width:640px){.options.wide{grid-template-columns:repeat(3,1fr);}}
.opt{
  min-height:48px;padding:12px 16px;border:2px solid var(--blue);border-radius:10px;
  background:var(--white);color:var(--ink);text-align:left;cursor:pointer;font-size:1.05rem;
}
.opt:hover{background:var(--blue-20);}
.opt.correct{background:var(--green-20);border-color:var(--green);font-weight:700;}
.opt.correct::before{content:"✔ ";}
.opt.wrong{background:var(--red-20);border-color:var(--red);font-weight:700;}
.opt.wrong::before{content:"✗ ";color:var(--red);}

.feedback{margin:8px 0 0;padding:10px 14px;border-radius:8px;font-weight:600;color:var(--ink);}
.feedback:empty{display:none;}
.feedback.good{background:var(--green-20);border-left:6px solid var(--green);}
.feedback.bad{background:var(--red-20);border-left:6px solid var(--red);}
.feedback.info{background:var(--blue-20);border-left:6px solid var(--blue);}

/* profile cards */
.profiles{display:grid;gap:10px;margin:0 0 4px;}
@media(min-width:640px){.profiles{grid-template-columns:repeat(3,1fr);}}
.profile{
  min-height:48px;padding:14px 16px;border:2px solid var(--blue);border-radius:10px;
  background:var(--white);color:var(--ink);text-align:left;cursor:pointer;display:grid;gap:2px;font-size:1rem;
}
.profile b{font-family:var(--font-head);font-weight:800;font-size:1.05rem;}
.profile:hover{background:var(--blue-20);}
.profile.correct{background:var(--green-20);border-color:var(--green);}
.profile.correct b::before{content:"✔ ";}
.profile.wrong{background:var(--red-20);border-color:var(--red);}
.profile.wrong b::before{content:"✗ ";color:var(--red);}

.profile-card{
  display:flex;gap:14px;align-items:center;
  background:var(--blue-20);border-left:6px solid var(--blue);border-radius:10px;
  padding:14px 16px;margin:0 0 14px;
}
.profile-card svg{flex:0 0 auto;width:56px;height:auto;}
.profile-card p{margin:0;font-size:1.05rem;}
.profile-card b{font-family:var(--font-head);font-weight:800;}

/* dialogue ordering */
.order-line{
  min-height:64px;border:3px dashed var(--blue);border-radius:10px;background:var(--blue-20);
  padding:10px;margin:0 0 12px;display:grid;gap:8px;
}
.order-line .placeholder{font-style:italic;}
.order-line.correct{border-style:solid;border-color:var(--green);background:var(--green-20);}
.order-line.wrong{border-style:solid;border-color:var(--red);background:var(--red-20);}
.line-bank{display:grid;gap:8px;margin:0 0 12px;}
.chip{
  min-height:48px;padding:12px 16px;border:2px solid var(--blue);border-radius:10px;
  background:var(--white);color:var(--ink);text-align:left;cursor:pointer;font-size:1.05rem;font-weight:600;width:100%;
}
.chip:hover{background:var(--blue-20);}
.chip[disabled]{opacity:.35;cursor:default;}
.actions{display:flex;flex-wrap:wrap;gap:10px;}

hr.sep{border:none;border-top:2px solid var(--grey);margin:24px 0;}

@media (prefers-reduced-motion: reduce){*{transition:none !important;animation:none !important;}}

@media(max-width:520px){
  body{font-size:17px;}
  h1{font-size:1.6rem;}
  .card{padding:20px 16px;}
  .nav .btn{flex:1 1 100%;}
}

</style>
</head>

